Cell["JITML  /  02", "SlideIndex"],

Cell["Adapt where the context changes", "Section"],

Cell["JITML keeps a changing pool of task specialists. Familiar contexts reuse existing networks; unfamiliar contexts trigger the generation of a new one.", "Text"],

Cell[BoxData[
GraphicsBox[{
{FaceForm[RGBColor[0.0863, 0.1059, 0.1333]], EdgeForm[Directive[RGBColor[0.4431, 0.6667, 1], AbsoluteThickness[1.4]]], RectangleBox[{210, 230}, {790, 288}, RoundingRadius->10]},
