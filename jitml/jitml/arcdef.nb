{FaceForm[RGBColor[0.0863, 0.1059, 0.1333]], EdgeForm[Directive[RGBColor[0.2353, 0.2784, 0.3373], AbsoluteThickness[1.4]]], RectangleBox[{35, 65}, {407, 277}, RoundingRadius->10]},
