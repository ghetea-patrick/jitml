InsetBox[StyleBox["Numerical grid or encoded input", FontFamily->"Source Sans Pro", FontSize->13.5, FontWeight->"Plain", FontColor->RGBColor[0.6588, 0.7098, 0.7765]], {500, 245}, Center],
{RGBColor[0.6588, 0.7098, 0.7765], AbsoluteThickness[1.6], Arrowheads[0.013], ArrowBox[{{500, 230}, {500, 206}}]},
